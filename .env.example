# 本机监听地址。登录数据使用 scripts/import-notion-session.py 导入 .local/。
HOST=127.0.0.1
PORT=8787
# 不填写时首次启动生成 .local/api-key.txt。
# API_KEY=change-me-to-a-long-random-secret
# 如需手动配置，在本地 .env 中填写以下三项，不要提交 GitHub。
# NOTION_TOKEN_V2=
# NOTION_USER_ID=
# NOTION_SPACE_ID=
# Notion 官方 integration token（ntn_...）不能代替网页登录会话。
